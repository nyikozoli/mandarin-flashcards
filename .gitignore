# Build output. CI builds dist/site and deploys it to GitHub Pages; nothing in dist/ is committed.
dist/

# Secrets: never committed; this repository is public. They live in .secrets/ (local only,
# also listed in .git/info/exclude so it stays ignored on every branch); the other patterns are a backstop.
.secrets/
.supabase-*
*-api-key
*-db-password
*-service-key
*.pem
.env
.env.*

# Supabase CLI local state (project ref, pooler URL, branch data)
supabase/.temp/
supabase/.branches/
.supabase/

# Local tooling and caches
.local/
.validation/
node_modules/
.claude/allow-main-commits
.claude/settings.local.json

# Python runtime that a Windows installer dropped in the repo root
Python/
.claude/launch.json
